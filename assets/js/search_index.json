---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "date": {{ post.date | date: "%d.%m.%Y" | jsonify }},
      "excerpt": {{ post.excerpt | strip_html | truncatewords: 50 | jsonify }},
      "content": {{ post.content | strip_html | jsonify }},
      "image": {{ post.image | relative_url | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% for page in site.pages %}
    {% if page.title != nil and page.title != '' and page.permalink != '/search/' %}
    {
      "title": {{ page.title | jsonify }},
      "url": {{ page.url | relative_url | jsonify }},
      "date": "",
      "excerpt": {{ page.content | strip_html | truncatewords: 50 | jsonify }},
      "content": {{ page.content | strip_html | jsonify }},
      "image": {% if page.image %}{{ page.image | relative_url | jsonify }}{% else %}""
      {% endif %}
    }{% unless forloop.last %},{% endunless %}
    {% endif %}
  {% endfor %}
]